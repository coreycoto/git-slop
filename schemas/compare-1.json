        "analyzer_version": {
          "$ref": "#/$defs/nullableString"
        },
        "config_digest": {
          "$ref": "#/$defs/nullableString"
        },
        "content_digest": {
          "$ref": "#/$defs/nullableString"
        },
        "context_tokenizer": {
