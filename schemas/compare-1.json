  "$id": "https://github.com/coreycoto/git-slop/blob/v0.11.6/schemas/compare-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_report": {
      "$ref": "#/$defs/reportDescriptor"
    },
    "baseline_compatible": {
      "type": "boolean"
    },
    "baseline_status": {
      "enum": [
        "compatible",
        "forced_incompatible",
        "incompatible"
      ]
    },
    "boundary_note": {
      "minLength": 1,
      "type": "string"
    },
    "command": {
      "const": "compare"
    },
    "compatibility_forced": {
      "type": "boolean"
    },
    "compatibility_mismatches": {
      "items": {
        "$ref": "#/$defs/compatibilityMismatch"
      },
      "type": "array"
    },
    "detail": {
      "enum": [
        "summary",
        "top",
        "full"
      ]
    },
    "file_deltas": {
      "items": {
        "$ref": "#/$defs/delta"
      },
      "type": "array"
    },
    "folder_deltas": {
      "items": {
        "$ref": "#/$defs/delta"
      },
      "type": "array"
    },
    "head_report": {
      "$ref": "#/$defs/reportDescriptor"
    },
    "include_unchanged": {
      "type": "boolean"
    },
    "overlay_deltas": {
      "items": {
        "$ref": "#/$defs/overlayDelta"
      },
      "type": "array"
    },
    "pagination": {
      "additionalProperties": {
        "$ref": "#/$defs/page"
      },
      "type": "object"
    },
    "policy_source": {
      "enum": [
        "base",
        "head"
      ]
    },
    "queue_movement": {
      "items": {
        "$ref": "#/$defs/queueMovement"
      },
      "type": "array"
    },
    "regressions": {
      "items": {
        "$ref": "#/$defs/regression"
      },
      "type": "array"
    },
    "report_schema_version": {
      "const": 5
    },
    "schema_version": {
      "const": 1
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "required": [
    "schema_version",
    "report_schema_version",
    "command",
    "policy_source",
    "base_report",
    "head_report",
    "summary",
    "file_deltas",
    "folder_deltas",
    "queue_movement",
    "overlay_deltas",
    "regressions",
    "boundary_note",
    "compatibility_forced",
    "baseline_status",
    "baseline_compatible",
    "compatibility_mismatches"
    ,"include_unchanged"
  ],
  "title": "Git Slop comparison schema 1",
  "type": "object"
}
