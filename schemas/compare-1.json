          "type": "string"
        },
        "slop_band_delta": {
          "$ref": "#/$defs/nullableInteger"
        },
        "slop_score_delta": {
          "$ref": "#/$defs/nullableNumber"
        },
        "status": {
          "enum": [
            "added",
            "removed",
            "source_changed",
            "evidence_drift",
            "aggregate_changed",
            "renamed",
            "unchanged"
