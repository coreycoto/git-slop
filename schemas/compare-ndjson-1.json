{
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.11.6/schemas/compare-ndjson-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "baseline_status": {
          "enum": [
            "compatible",
            "forced_incompatible",
            "incompatible"
          ]
        },
        "pagination": {
          "type": [
            "object",
            "null"
          ]
        },
        "record_type": {
          "const": "summary"
        },
        "schema_version": {
          "const": 1
        },
        "stream": {
          "type": "object"
        },
        "summary": {
          "type": "object"
        }
      },
      "required": [
        "record_type",
        "schema_version",
        "stream",
        "summary",
        "baseline_status"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "record": {
          "type": "object"
        },
        "record_type": {
          "enum": [
            "file_delta",
            "folder_delta",
            "queue_movement",
            "overlay_delta",
            "regression"
          ]
        }
      },
      "required": [
        "record_type",
        "record"
      ],
      "type": "object"
    }
  ],
  "title": "Git Slop compare NDJSON record schema 1"
}
