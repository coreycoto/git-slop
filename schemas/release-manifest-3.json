{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreycoto/git-slop/blob/main/schemas/release-manifest-3.json",
  "title": "Git Slop release manifest schema 3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "version", "tag", "revision", "repository", "crate_source", "artifacts", "checksums", "install"],
  "properties": {
    "schema_version": { "const": 3 },
    "project": { "const": "git-slop" },
    "version": { "$ref": "#/$defs/version" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "revision": { "$ref": "#/$defs/revision" },
    "repository": { "const": "coreycoto/git-slop" },
    "crate_source": { "$ref": "#/$defs/crate_source" },
    "artifacts": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/artifact" } },
    "supplemental_assets": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/supplemental_asset" } },
    "checksums": { "$ref": "#/$defs/checksums" },
    "install": { "$ref": "#/$defs/install" }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "https_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "crate_source": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "registry", "package", "version", "url", "sha256", "revision", "vcs_dirty"],
      "properties": {
        "schema_version": { "const": 1 }, "registry": { "const": "crates.io" }, "package": { "const": "git-slop" },
        "version": { "$ref": "#/$defs/version" }, "url": { "$ref": "#/$defs/https_url" }, "sha256": { "$ref": "#/$defs/sha256" },
        "revision": { "$ref": "#/$defs/revision" }, "vcs_dirty": { "const": false }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "path", "target", "os", "arch", "archive", "sha256", "size_bytes", "url"],
      "properties": {
        "name": { "type": "string", "pattern": "^git-slop-v[0-9]+\\.[0-9]+\\.[0-9]+-[a-z0-9_-]+\\.(tar\\.gz|zip)$" },
        "path": { "type": "string", "pattern": "^[^/]+$" },
        "target": { "enum": ["aarch64-apple-darwin", "aarch64-pc-windows-msvc", "aarch64-unknown-linux-gnu", "x86_64-apple-darwin", "x86_64-pc-windows-msvc", "x86_64-unknown-linux-gnu", "x86_64-unknown-linux-musl"] },
        "os": { "enum": ["macos", "windows", "linux"] }, "arch": { "enum": ["aarch64", "x86_64"] }, "archive": { "enum": ["tar.gz", "zip"] },
        "sha256": { "$ref": "#/$defs/sha256" }, "size_bytes": { "type": "integer", "minimum": 1, "maximum": 134217728 }, "url": { "$ref": "#/$defs/https_url" }
      }
    },
    "supplemental_asset": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "path", "role", "media_type", "required", "contract_version", "sha256", "size_bytes", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }, "path": { "type": "string", "pattern": "^[^/]+$" },
        "role": { "enum": ["homebrew_formula", "cyclonedx_sbom", "spdx_sbom"] }, "media_type": { "type": "string", "minLength": 1 },
        "required": { "const": true }, "contract_version": { "const": 1 }, "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 }, "url": { "$ref": "#/$defs/https_url" }
      }
    },
    "checksums": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "name", "url"],
      "properties": { "algorithm": { "const": "sha256" }, "name": { "const": "SHA256SUMS" }, "url": { "$ref": "#/$defs/https_url" } }
    },
    "commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "install": {
      "type": "object", "additionalProperties": false, "required": ["attestation", "cargo", "homebrew_tap", "github_release", "scoop"],
      "properties": {
        "attestation": { "$ref": "#/$defs/commands" }, "cargo": { "$ref": "#/$defs/commands" },
        "homebrew_tap": { "$ref": "#/$defs/commands" }, "github_release": { "$ref": "#/$defs/commands" }, "scoop": { "$ref": "#/$defs/commands" }
      }
    }
  }
}
