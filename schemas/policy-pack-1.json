{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.16.0/schemas/policy-pack-1.json",
  "title": "Git Slop policy pack schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "description", "version", "license", "min_git_slop_version", "entrypoints", "applicability", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "version": {"$ref": "#/$defs/semver"},
    "license": {"type": "string", "minLength": 1, "maxLength": 80},
    "min_git_slop_version": {"$ref": "#/$defs/semver"},
    "entrypoints": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^policies/[A-Za-z0-9._/-]+\\.md$"}
    },
    "applicability": {"$ref": "#/$defs/applicability"},
    "tests": {
      "type": "array", "maxItems": 32, "uniqueItems": true, "default": [],
      "items": {"type": "string", "pattern": "^tests/[A-Za-z0-9._/-]+\\.ya?ml$"}
    },
    "rules": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "verdict": {"enum": ["approve", "abstain", "revise", "reject"]},
    "applicability": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": {"enum": ["advise", "plan"]}
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "applicability", "severity", "consequence", "required_evidence", "insufficient_evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "applicability": {"$ref": "#/$defs/applicability"},
        "severity": {"enum": ["warning", "error"]},
        "consequence": {"$ref": "#/$defs/verdict"},
        "required_evidence": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
        "insufficient_evidence": {"$ref": "#/$defs/verdict"},
        "remediation": {"type": ["string", "null"], "maxLength": 2000, "default": null},
        "conflicts_with": {"type": "array", "maxItems": 32, "uniqueItems": true, "default": [], "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
