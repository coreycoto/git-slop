{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.16.0/schemas/advice-response-1.json",
  "title": "Git Slop advisor provider response schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "aggregate_verdict", "summary", "candidate_evaluations"],
  "properties": {
    "schema_version": {"const": 1},
    "aggregate_verdict": {"$ref": "#/$defs/verdict"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "candidate_evaluations": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "verdict": {"enum": ["approve", "abstain", "revise", "reject"]},
    "stringList": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "citations": {
      "type": "object", "additionalProperties": false,
      "required": ["candidates", "paths", "findings", "relationships", "clusters", "excerpts", "policies", "verification"],
      "properties": {
        "candidates": {"$ref": "#/$defs/citationList"}, "paths": {"$ref": "#/$defs/citationList"},
        "findings": {"$ref": "#/$defs/citationList"}, "relationships": {"$ref": "#/$defs/citationList"},
        "clusters": {"$ref": "#/$defs/citationList"}, "excerpts": {"$ref": "#/$defs/citationList"},
        "policies": {"$ref": "#/$defs/citationList"}, "verification": {"$ref": "#/$defs/citationList"}
      }
    },
    "citationList": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "verdict", "rationale", "citations"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 3, "maxLength": 160},
        "verdict": {"$ref": "#/$defs/verdict"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
        "citations": {"$ref": "#/$defs/citations"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "verdict", "rationale", "rule_evaluations", "citations", "requested_revisions", "recommended_next_step", "assumptions", "missing_evidence", "confidence"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^candidate-[a-f0-9]{16}$"},
        "verdict": {"$ref": "#/$defs/verdict"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
        "rule_evaluations": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/rule"}},
        "citations": {"$ref": "#/$defs/citations"},
        "requested_revisions": {"$ref": "#/$defs/stringList"},
        "recommended_next_step": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
        "assumptions": {"$ref": "#/$defs/stringList"},
        "missing_evidence": {"$ref": "#/$defs/stringList"},
        "confidence": {"enum": ["low", "medium", "high"]}
      }
    }
  }
}
