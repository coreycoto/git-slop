{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.16.1/schemas/advisor-review-manifest-1.json",
  "title": "Git Slop advisor private review manifest schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "protocol", "source_results_sha256", "blind_index_sha256", "minimum_reviewers", "minimum_repetitions_per_case", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["complete", "incomplete"]},
    "protocol": {"const": "blind-independent-multi-repeat-v1"},
    "source_results_sha256": {"$ref": "#/$defs/digest"},
    "blind_index_sha256": {"$ref": "#/$defs/digest"},
    "minimum_reviewers": {"const": 2},
    "minimum_repetitions_per_case": {"const": 2},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "artifact_file", "review_artifact_sha256", "source_artifact_sha256", "sample_sha256", "case_id", "reasoning_effort", "context_token_limit", "repetition"],
      "properties": {
        "review_id": {"type": "string", "pattern": "^review-[0-9]{6}$"},
        "artifact_file": {"type": "string", "pattern": "^review-[0-9]{6}\\.json$"},
        "review_artifact_sha256": {"$ref": "#/$defs/digest"},
        "source_artifact_sha256": {"$ref": "#/$defs/digest"},
        "sample_sha256": {"$ref": "#/$defs/digest"},
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "reasoning_effort": {"enum": ["low", "medium", "high"]},
        "context_token_limit": {"const": 8192},
        "repetition": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    }
  }
}
