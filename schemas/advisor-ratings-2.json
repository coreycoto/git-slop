{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.16.1/schemas/advisor-ratings-2.json",
  "title": "Git Slop advisor independent blinded ratings schema 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "source_results_sha256", "review_manifest_sha256", "reviewers"],
  "properties": {
    "schema_version": {"const": 2},
    "protocol": {"const": "blind-independent-multi-repeat-v1"},
    "source_results_sha256": {"$ref": "#/$defs/digest"},
    "review_manifest_sha256": {"$ref": "#/$defs/digest"},
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/reviewer"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "score": {"type": "number", "minimum": 1, "maximum": 5},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "independent", "blinded", "ratings"],
      "properties": {
        "reviewer_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "independent": {"const": true},
        "blinded": {"const": true},
        "ratings": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^review-[0-9]{6}$"},
          "additionalProperties": {"$ref": "#/$defs/rating"}
        }
      }
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation_usefulness", "fact_interpretation_separation", "scope_quality", "verification_quality", "actionability", "unsupported_claim_count"],
      "properties": {
        "recommendation_usefulness": {"$ref": "#/$defs/score"},
        "fact_interpretation_separation": {"$ref": "#/$defs/score"},
        "scope_quality": {"$ref": "#/$defs/score"},
        "verification_quality": {"$ref": "#/$defs/score"},
        "actionability": {"$ref": "#/$defs/score"},
        "unsupported_claim_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
