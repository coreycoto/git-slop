{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.11.3/schemas/check-1.json",
  "title": "Git Slop check schema 1",
  "type": "object",
  "required": ["schema_version", "command", "report", "boundary", "passed", "finding_count", "details_included", "gate_scope"],
  "properties": {
    "schema_version": {"const": 1},
    "command": {"const": "check"},
    "report": {"type": "object", "required": ["schema_version", "analyzer", "repo", "scope"], "properties": {"schema_version": {"type": "integer"}, "analyzer": {"type": "object"}, "repo": {"type": "object"}, "scope": {"type": "object"}}, "additionalProperties": false},
    "boundary": {"type": "object", "required": ["context_band", "slop_band"], "properties": {"context_band": {"enum": ["compact", "healthy", "warning", "critical"]}, "slop_band": {"enum": ["low", "moderate", "high", "critical"]}}, "additionalProperties": false},
    "passed": {"type": "boolean"},
    "finding_count": {"type": "integer", "minimum": 0},
    "details_included": {"type": "boolean"},
    "gate_scope": {"enum": ["files", "files_and_folders"]},
    "findings": {"type": "array", "items": {"type": "object"}},
    "collection": {"type": "object", "required": ["total", "offset", "limit", "returned", "truncated"], "properties": {"total": {"type": "integer", "minimum": 0}, "offset": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 10000}, "returned": {"type": "integer", "minimum": 0}, "truncated": {"type": "boolean"}}, "additionalProperties": false}
  },
  "allOf": [
    {"if": {"properties": {"details_included": {"const": true}}}, "then": {"required": ["findings", "collection"]}},
    {"if": {"properties": {"details_included": {"const": false}}}, "then": {"not": {"anyOf": [{"required": ["findings"]}, {"required": ["collection"]}]}}}
  ],
  "additionalProperties": false
}
