{
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.11.6/schemas/check-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "details_included": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "findings",
          "collection"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "details_included": {
            "const": false
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "findings"
              ]
            },
            {
              "required": [
                "collection"
              ]
            }
          ]
        }
      }
    }
  ],
  "properties": {
    "boundary": {
      "additionalProperties": false,
      "properties": {
        "context_band": {
          "enum": [
            "compact",
            "healthy",
            "warning",
            "critical"
          ]
        },
        "slop_band": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical"
          ]
        }
      },
      "required": [
        "context_band",
        "slop_band"
      ],
      "type": "object"
    },
    "collection": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "returned": {
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "total",
        "offset",
        "limit",
        "returned",
        "truncated"
      ],
      "type": "object"
    },
    "command": {
      "const": "check"
    },
    "details_included": {
      "type": "boolean"
    },
    "finding_count": {
      "minimum": 0,
      "type": "integer"
    },
    "findings": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "gate_scope": {
      "enum": [
        "files",
        "files_and_folders"
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "report": {
      "additionalProperties": false,
      "properties": {
        "analyzer": {
          "type": "object"
        },
        "repo": {
          "type": "object"
        },
        "schema_version": {
          "type": "integer"
        },
        "scope": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "analyzer",
        "repo",
        "scope"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "command",
    "report",
    "boundary",
    "passed",
    "finding_count",
    "details_included",
    "gate_scope"
  ],
  "title": "Git Slop check schema 1",
  "type": "object"
}
