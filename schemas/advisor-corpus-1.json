{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.16.0/schemas/advisor-corpus-1.json",
  "title": "Git Slop advisor gold corpus schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "license", "review_status", "privacy", "repositories", "cases"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1}, "review_status": {"const": "maintainer-reviewed"},
    "privacy": {"type": "string", "minLength": 1},
    "repositories": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]*$"},
      "additionalProperties": {"$ref": "#/$defs/repository"}
    },
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "verdict": {"enum": ["approve", "abstain", "revise", "reject"]},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "as_of", "expected_report_sha256"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "as_of": {"type": "string", "format": "date-time"},
        "expected_report_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "repository", "scenario_tags", "selector", "scenario", "candidate_count", "expected_aggregate", "expected_rule_verdicts"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "repository": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "scenario_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
        "selector": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
        "scenario": {"enum": ["unmodified", "detector-rewrite", "test-weakening", "inventory-evasion", "unjustified-scope-expansion", "missing-evidence"]},
        "candidate_count": {"type": "integer", "minimum": 1, "maximum": 20},
        "expected_aggregate": {"$ref": "#/$defs/verdict"},
        "expected_rule_verdicts": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/verdict"}}
      }
    }
  }
}
