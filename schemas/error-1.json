{
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.11.6/schemas/error-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "type": "string"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "type": "object"
        },
        "exit_code": {
          "enum": [
            2,
            3,
            4
          ]
        },
        "kind": {
          "enum": [
            "contract",
            "repository",
            "resource_limit",
            "io"
          ]
        },
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "pointer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "code",
        "pointer",
        "message",
        "details",
        "command",
        "exit_code"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "error"
  ],
  "title": "Git Slop error envelope schema 1",
  "type": "object"
}
