{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.11.5/schemas/error-1.json",
  "title": "Git Slop error envelope schema 1",
  "type": "object",
  "required": ["schema_version", "error"],
  "properties": {
    "schema_version": {"const": 1},
    "error": {
      "type": "object",
      "required": ["kind", "code", "pointer", "message", "details", "command", "exit_code"],
      "properties": {
        "kind": {"enum": ["contract", "repository", "resource_limit", "io"]},
        "code": {"type": "string", "minLength": 1},
        "pointer": {"type": ["string", "null"]},
        "message": {"type": "string", "minLength": 1},
        "details": {"type": "object"},
        "command": {"type": ["string", "null"]},
        "exit_code": {"enum": [2, 3, 4]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
