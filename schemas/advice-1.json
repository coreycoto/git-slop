{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.16.0/schemas/advice-1.json",
  "title": "Git Slop validated advice artifact schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "generated_at", "report", "selector", "candidate_ids", "context", "policies", "provider", "timing", "response_sha256", "evaluation", "validation", "boundary"],
  "properties": {
    "schema_version": {"const": 1}, "command": {"const": "advise"}, "generated_at": {"type": "string", "format": "date-time"},
    "report": {"type": "object", "required": ["canonical_sha256"]}, "selector": {"type": "object"},
    "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^candidate-[a-f0-9]{16}$"}},
    "context": {"type": "object", "additionalProperties": false, "required": ["builder_version", "digest", "limits", "missing_evidence", "reference_index"], "properties": {"builder_version": {"const": 1}, "digest": {"$ref": "#/$defs/digest"}, "limits": {"type": "object"}, "missing_evidence": {"type": "array"}, "reference_index": {"type": "object"}}},
    "policies": {"type": "object", "additionalProperties": false, "required": ["resolution_digest", "packs", "conflicts"], "properties": {"resolution_digest": {"$ref": "#/$defs/digest"}, "packs": {"type": "array"}, "conflicts": {"type": "array"}}},
    "provider": {"type": "object", "required": ["provider", "model", "requested_runtime_model", "endpoint_classification", "reasoning_effort", "timeout_ms", "max_response_bytes", "max_output_tokens", "context_window_tokens", "runtime_label", "model_digest"]},
    "timing": {"type": "object", "additionalProperties": false, "required": ["context_elapsed_ms", "provider_elapsed_ms", "validation_elapsed_ms", "time_to_validated_artifact_ms"], "properties": {"context_elapsed_ms": {"type": "integer", "minimum": 0}, "provider_elapsed_ms": {"type": "integer", "minimum": 0}, "validation_elapsed_ms": {"type": "integer", "minimum": 0}, "time_to_validated_artifact_ms": {"type": "integer", "minimum": 0}}},
    "response_sha256": {"$ref": "#/$defs/digest"},
    "evaluation": {"type": "object", "required": ["schema_version", "reported_aggregate_verdict", "aggregate_verdict", "summary", "candidate_evaluations", "warnings"]},
    "validation": {"type": "object", "additionalProperties": false, "required": ["status", "aggregate_recomputed", "references_validated", "warnings"], "properties": {"status": {"const": "valid"}, "aggregate_recomputed": {"const": true}, "references_validated": {"const": true}, "warnings": {"type": "array", "items": {"type": "string"}}}},
    "boundary": {"const": "Policy-guided advice is non-mutating and advisory. It cannot rewrite detector truth or change git slop check results."}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
