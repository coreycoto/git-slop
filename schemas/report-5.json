          "profile",
          "slop_score",
          "slop_band",
          "context_band",
          "tokens",
          "age_days",
          "revisions_window",
          "churn_pressure",
          "reason_codes",
          "is_pure_context_hotspot",
          "severity",
          "evidence_status",
          "next_action"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "analyzed_revision_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "analyzer": {
      "additionalProperties": false,
      "properties": {
        "analysis_clock": {
          "format": "date-time",
          "type": "string"
        },
        "analysis_config_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "analysis_contract_version": {
          "minimum": 1,
          "type": "integer"
        },
        "config_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "context_tokenizer": {
          "type": "string"
        },
        "evidence_config_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "name": {
          "const": "git-slop"
        },
        "policy_config_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "presentation_config_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "report_profile": {
          "enum": [
            "compact",
            "standard",
            "full_evidence"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "report_profile",
        "analysis_contract_version",
        "config_digest",
