  "$id": "https://github.com/coreycoto/git-slop/blob/v0.11.5/schemas/report-5.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_queue": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "age_days": {
            "type": "integer"
