{
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.11.6/schemas/doctor-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "advisor": {
      "properties": {
        "benchmark_feature_compiled": {
          "type": "boolean"
        },
        "default_mode": {
          "const": "provider_free_json"
        },
        "decision_record": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "model_required_for_ordinary_use": {
          "const": false
        },
        "provider_free_context_available": {
          "const": true
        },
        "public_inference_enabled": {
          "type": "boolean"
        },
        "recommendation": {
          "enum": [
            "ship",
            "adjust",
            "defer"
          ]
        },
        "status": {
          "enum": [
            "available",
            "invalid_release_gate"
          ]
        }
      },
      "required": [
        "status",
        "default_mode",
        "provider_free_context_available",
        "model_required_for_ordinary_use",
        "public_inference_enabled",
        "benchmark_feature_compiled"
      ],
      "type": "object"
    },
    "adoption": {
      "type": "object"
    },
    "command": {
      "const": "doctor"
    },
    "config": {
      "type": "object"
    },
    "estimate": {
      "type": "object"
    },
    "report": {
      "type": "object"
    },
    "report_available": {
      "type": "boolean"
    },
    "repository": {
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "scan_ready": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ready",
        "not_ready",
        "error"
      ]
    }
  },
  "required": [
    "schema_version",
    "command",
    "status",
    "scan_ready",
    "report_available",
    "repository",
    "adoption",
    "config",
    "report",
    "estimate"
  ],
  "title": "Git Slop doctor schema 1",
  "type": "object"
}
