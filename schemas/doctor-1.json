{
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.11.6/schemas/doctor-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "advisor": {
      "additionalProperties": false,
      "properties": {
        "benchmark_feature_compiled": {
          "type": "boolean"
        },
        "default_mode": {
          "const": "provider_free_markdown"
        },
        "decision_record": {
          "type": "string"
        },
        "decision_record_url": {
          "pattern": "^https://github\\.com/coreycoto/git-slop/blob/v[0-9]+\\.[0-9]+\\.[0-9]+/docs/benchmarks/[^?#]+\\.md$",
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "model_required_for_ordinary_use": {
          "const": false
        },
        "machine_context_mode": {
          "const": "provider_free_json"
        },
        "inference_status": {
          "enum": [
            "enabled",
            "deferred",
            "disabled",
            "unavailable"
          ]
        },
        "provider_free_status": {
          "const": "available"
        },
        "provider_free_context_available": {
          "const": true
        },
        "public_inference_enabled": {
          "type": "boolean"
        },
        "recommendation": {
          "enum": [
            "ship",
            "adjust",
            "defer"
          ]
        },
        "state": {
          "additionalProperties": false,
          "properties": {
            "detail": {"type": "string"},
            "latest": {"enum": ["missing", "valid", "stale", "invalid"]},
            "private_permissions": {"type": "boolean"},
            "recovery_entries": {"type": "integer", "minimum": 0},
            "retained_bytes": {"type": "integer", "minimum": 0},
            "retained_runs": {"type": "integer", "minimum": 0},
            "retention_command": {"const": "git slop prune --dry-run"},
            "status": {"enum": ["missing", "valid", "stale", "invalid", "recovery_required", "insecure_permissions"]}
          },
          "required": ["status", "latest", "retained_runs", "retained_bytes", "private_permissions", "recovery_entries", "retention_command"],
          "type": "object"
        },
        "status": {
          "enum": [
            "available",
            "invalid_release_gate"
          ]
        }
      },
      "required": [
        "status",
        "provider_free_status",
        "inference_status",
        "default_mode",
        "machine_context_mode",
        "provider_free_context_available",
        "model_required_for_ordinary_use",
        "public_inference_enabled",
        "benchmark_feature_compiled",
        "state"
      ],
      "type": "object"
    },
    "adoption": {
      "type": "object"
    },
    "command": {
      "const": "doctor"
    },
    "config": {
      "type": "object"
    },
    "estimate": {
      "type": "object"
    },
    "report": {
      "type": "object"
    },
    "report_available": {
      "type": "boolean"
    },
    "repository": {
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "scan_ready": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ready",
        "not_ready",
        "error"
      ]
    }
  },
  "required": [
    "schema_version",
    "command",
    "status",
    "scan_ready",
    "report_available",
    "repository",
    "adoption",
    "config",
    "report",
    "estimate"
  ],
  "title": "Git Slop doctor schema 1",
  "type": "object"
}
