{
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.11.6/schemas/doctor-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "adoption": {
      "type": "object"
    },
    "command": {
      "const": "doctor"
    },
    "config": {
      "type": "object"
    },
    "estimate": {
      "type": "object"
    },
    "report": {
      "type": "object"
    },
    "report_available": {
      "type": "boolean"
    },
    "repository": {
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "scan_ready": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ready",
        "not_ready",
        "error"
      ]
    }
  },
  "required": [
    "schema_version",
    "command",
    "status",
    "scan_ready",
    "report_available",
    "repository",
    "adoption",
    "config",
    "report",
    "estimate"
  ],
  "title": "Git Slop doctor schema 1",
  "type": "object"
}
