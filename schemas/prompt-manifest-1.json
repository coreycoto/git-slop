{
  "$id": "https://github.com/coreycoto/git-slop/blob/v0.11.6/schemas/prompt-manifest-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "enum": [
        "explain",
        "plan"
      ]
    },
    "files": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "required": [
        "context.json",
        "prompt.md",
        "README.md",
        "response-template.md",
        "verification.md"
      ],
      "type": "object"
    },
    "prompt_pack_version": {
      "const": 1
    },
    "report": {
      "additionalProperties": false,
      "properties": {
        "config_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "canonicalization": {
          "const": "serde_json_compact_preserve_order_v1"
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "schema_version": {
          "minimum": 4,
          "type": "integer"
        },
        "source_path": {
          "type": "string"
        },
        "scope": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "config_digest",
        "scope",
        "head_sha",
        "report_sha256",
        "canonical_report_sha256",
        "canonicalization",
        "source_path",
        "generated_at"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "prompt_pack_version",
    "command",
    "files",
    "report"
  ],
  "title": "Git Slop prompt manifest schema 1",
  "type": "object"
}
