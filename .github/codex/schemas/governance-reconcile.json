{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["approved", "declined", "noop", "blocked", "rejected", "failed"]
    },
    "summary": { "type": "string" },
    "approved_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "const": "label-palette" },
          "plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "operation_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          }
        },
        "required": ["name", "plan_sha256", "operation_ids"],
        "additionalProperties": false
      },
      "maxItems": 1
    },
    "preview_artifacts": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["status", "summary", "approved_plans", "preview_artifacts", "notes"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": { "properties": { "approved_plans": { "minItems": 1 } } },
      "else": { "properties": { "approved_plans": { "maxItems": 0 } } }
    }
  ]
}
